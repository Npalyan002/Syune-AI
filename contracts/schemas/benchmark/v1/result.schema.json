{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syune.local/schemas/benchmark/v1/result.schema.json",
  "title": "SYUNE Benchmark Result v1",
  "type": "object",
  "required": ["run_id", "timestamp", "git_commit", "working_tree_state", "system", "system_version", "adapter_version", "model", "model_version", "model_parameters", "dataset_id", "dataset_version", "seed", "dataset_metadata", "benchmark", "benchmark_version", "case_count", "passed", "failed", "task_success", "metrics", "tokens", "latency_ms", "cost", "storage_before", "storage_after", "errors", "warnings", "unsupported_capabilities", "samples"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "git_commit": {"type": "string"},
    "working_tree_state": {"enum": ["CLEAN", "DIRTY", "UNKNOWN"]},
    "system": {"type": "string"},
    "system_version": {"type": "string"},
    "adapter_version": {"type": "string"},
    "adapter_status": {"enum": ["READY", "NOT_CONFIGURED", "BLOCKED"]},
    "model": {"type": ["string", "null"]},
    "model_version": {"type": ["string", "null"]},
    "model_parameters": {"type": "object"},
    "dataset_id": {"type": "string"},
    "dataset_version": {"type": "string"},
    "seed": {"type": "integer"},
    "dataset_metadata": {
      "type": "object",
      "required": ["generator_version", "created_at", "case_count", "content_hash", "tier"]
    },
    "benchmark": {"type": "string"},
    "benchmark_version": {"type": "string"},
    "case_count": {"type": "integer", "minimum": 0},
    "passed": {"type": "integer", "minimum": 0},
    "failed": {"type": "integer", "minimum": 0},
    "task_success": {"type": "number", "minimum": 0, "maximum": 1},
    "metrics": {"type": "object"},
    "tokens": {"type": "object"},
    "latency_ms": {"type": "object"},
    "cost": {"type": "object", "required": ["status", "amount", "currency"]},
    "storage_before": {"type": "object"},
    "storage_after": {"type": "object"},
    "errors": {"type": "array"},
    "warnings": {"type": "array"},
    "unsupported_capabilities": {"type": "array", "items": {"type": "string"}},
    "samples": {"type": "array"}
  },
  "additionalProperties": true
}
