[Unit]
Description=SYUNE AML Textual Memory Adapter
After=network.target
RequiresMountsFor=/var/lib/syune-aml

[Service]
Type=simple
User=syune-aml
Group=syune-aml
WorkingDirectory=/opt/syune-aml/current
EnvironmentFile=/etc/syune-aml/environment
LoadCredential=aml-bearer-token:/etc/syune-aml/aml-bearer-token
Environment=SYUNE_AML_BEARER_TOKEN_FILE=%d/aml-bearer-token
ExecStart=/opt/syune-aml/current/.venv/bin/uvicorn syune.adapters.aml.v1:app_from_environment --factory --host 127.0.0.1 --port 8080 --workers 1 --limit-concurrency 8 --timeout-keep-alive 5 --timeout-graceful-shutdown 1800 --no-access-log --no-server-header
Restart=on-failure
RestartSec=5
TimeoutStopSec=1860
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/syune-aml
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
