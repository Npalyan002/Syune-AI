worker_processes 1;
pid /tmp/nginx.pid;
events { worker_connections 256; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    log_format operations escape=json '{"time":"$time_iso8601","method":"$request_method","path":"$uri","status":$status,"duration":$request_time,"upstream_status":"$upstream_status","upstream_time":"$upstream_response_time"}';
    access_log /dev/stdout operations;
    error_log /dev/stderr warn;
    limit_req_zone $binary_remote_addr zone=aml_per_ip:10m rate=${AML_NGINX_RATE};
    limit_conn_zone $binary_remote_addr zone=aml_connections:10m;
    limit_req_status 429;
    limit_conn_status 429;
    map $status $retry_after { 429 "1"; 503 "1"; default ""; }
    upstream syune_aml { server app:8080; keepalive 64; }
    server {
        listen 8443 ssl;
        server_name localhost;
        ssl_certificate /run/tls/fullchain.pem;
        ssl_certificate_key /run/tls/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_tickets off;
        add_header Retry-After $retry_after always;
        client_max_body_size 1m;
        client_body_timeout 30s;
        location = /health { proxy_pass http://syune_aml; proxy_connect_timeout 5s; proxy_read_timeout 10s; }
        location ~ ^/(add|search)$ {
            limit_req zone=aml_per_ip burst=${AML_NGINX_BURST} nodelay;
            limit_conn aml_connections ${AML_NGINX_CONNECTIONS};
            proxy_pass http://syune_aml;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Connection "";
            proxy_connect_timeout 5s;
            proxy_send_timeout 180s;
            proxy_read_timeout 180s;
            proxy_request_buffering on;
        }
        location / { return 404; }
    }
}
