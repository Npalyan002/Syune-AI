+
+
+def main() -> None:
+    docs, queries = [], []
+    places = ("Cedarport", "Elmstead", "Foxhaven", "Glenmoor", "Highridge", "Ironbay")
+    states = ("amber", "blue", "coral", "green", "silver", "violet")
